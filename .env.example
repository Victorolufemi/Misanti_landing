# Public URL of the landing page (Open Graph / canonical)
NEXT_PUBLIC_SITE_URL="https://list.misanti.agency"

# Optional: every waitlist signup is POSTed here as JSON
# (Google Apps Script → Sheet, Zapier, Make, n8n, etc.).
# If empty, signups are appended to data/waitlist.jsonl (local/dev only —
# serverless filesystems are ephemeral, so set this before launch).
WAITLIST_WEBHOOK_URL=""

# Optional: YouTube/Vimeo embed URL or an .mp4 path for the hero video.
NEXT_PUBLIC_VIDEO_URL=""
